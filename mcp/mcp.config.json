{
  "mcpServers": {
    "playwright-manufacton": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--storage-state",
        "shared/auth/storage/manufacton.json",
        "--output-dir",
        "mcp/ai-generated/manufacton",
        "--viewport-size",
        "1280x720"
      ]
    },
    "playwright-bimplus": {
      "command": "npx",
      "args": [
